class Solution:
    def partition(self, s: str):
        res =[]
        part = []

        def isPalindrome(s, start, end):
            string = s[start: end+1]
            if string == string[::-1]:
                return True
            return False

        def dfs(i):
            if i >= len(s):
                res.append(part.copy())
                return
            
            for j in range(i, len(s)):
                if isPalindrome(s, i, j):
                    part.append(s[i: j+1])
                    dfs(j+1)
                    part.pop()
        
        dfs(0)
        return res

            





