      "locked": false,
      "text": "struct TreeNode\n{\n   int val;\n   TreeNode* left;\n   TreeNode* right;\n\n   TreeNode(int x): val(x), left(nullptr), right(nullptr) {}\n};\n\n\nclass Solution \n{\n   vector<int> inOrderSequence;\n\n   bool isValidBST(TreeNode* root) {\n      if (!root) return false;\n      inOrderTraverse(root);\n      \n      for (int i=0; i<inOrderSequence.size()-1; i++) {\n         if (inOrderSequence[i+1] <= inOrderSequence[i]) {\n             return false;\n         }\n      }\n      return true;\n      \n       \n   }\n\n   \n\n   void inOrderTraverse(TreeNode* root) {\n      if (!root) return;\n      \n      inOrderTraverse(root.left);\n      inOrderSequence.push_back(root->val);\n      inOrderTraverse(root.right);\n   }\n};",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "struct TreeNode\n{\n   int val;\n   TreeNode* left;\n   TreeNode* right;\n\n   TreeNode(int x): val(x), left(nullptr), right(nullptr) {}\n};\n\n\nclass Solution \n{\n   vector<int> inOrderSequence;\n\n   bool isValidBST(TreeNode* root) {\n      if (!root) return false;\n      inOrderTraverse(root);\n      \n      for (int i=0; i<inOrderSequence.size()-1; i++) {\n         if (inOrderSequence[i+1] <= inOrderSequence[i]) {\n             return false;\n         }\n      }\n      return true;\n      \n       \n   }\n\n   \n\n   void inOrderTraverse(TreeNode* root) {\n      if (!root) return;\n      \n      inOrderTraverse(root.left);\n      inOrderSequence.push_back(root->val);\n      inOrderTraverse(root.right);\n   }\n};",
      "autoResize": true,
      "lineHeight": 1.25
