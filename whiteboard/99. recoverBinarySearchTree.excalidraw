      "updated": 1763841609979,
      "link": null,
      "locked": false,
      "text": "Subtree Property: node , func(node.left), func(node.right)\n\nclass Solution\n{\n   bool isSymmetric(TreeNode* root) \n   {\n      if (!root) return true;\n      return isMirror(root->left, root->right);\n   }\n    \n   bool isMirror(TreeNode* left, TreeNode* right) \n   {\n      if (!left && !right): return true;\n      if (!left || !right): return false;\n      \n      return left->val == right->val \n      && isMirror(left->left, right->right) && isMirror(left->right, right->left);\n   }\n};\n ",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Subtree Property: node , func(node.left), func(node.right)\n\nclass Solution\n{\n   bool isSymmetric(TreeNode* root) \n   {\n      if (!root) return true;\n      return isMirror(root->left, root->right);\n   }\n    \n   bool isMirror(TreeNode* left, TreeNode* right) \n   {\n      if (!left && !right): return true;\n      if (!left || !right): return false;\n      \n      return left->val == right->val \n      && isMirror(left->left, right->right) && isMirror(left->right, right->left);\n   }\n};\n ",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
